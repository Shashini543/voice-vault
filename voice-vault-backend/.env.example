# Copy this file to .env and fill in real values. Never commit .env.

DATABASE_URL=

AWS_REGION=
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

JWT_SECRET_KEY=
GEMINI_API_KEY=

# Used to build links in emails (e.g. password reset) that point back to the frontend.
# Production: set this to your deployed Vercel frontend URL, e.g. https://voice-vault.vercel.app
FRONTEND_URL=http://localhost:3000

# Must be a verified sender identity (email address or domain) in Amazon SES.
SES_SENDER_EMAIL=

# Google OAuth 2.0 Web Application client (Google Cloud Console -> APIs & Services -> Credentials).
# GOOGLE_REDIRECT_URI must exactly match an "Authorized redirect URI" configured on that client.
# Production: this must point at your deployed Render backend, e.g.
# https://voice-vault-backend.onrender.com/auth/google/callback -- and that exact URL must also
# be added as an Authorized redirect URI on the Google Cloud OAuth client, or sign-in will fail.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# Comma-separated list of allowed frontend origins (no trailing slashes, no wildcards).
# Production: set this to your deployed Vercel frontend URL, e.g. https://voice-vault.vercel.app
# You can include both a production and preview URL, comma-separated, if needed.
CORS_ORIGINS=http://localhost:3000
